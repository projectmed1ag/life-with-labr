[Unit]
Description=Life with Labr website and CMS
After=network.target

[Service]
Type=simple
User=lifewithlabr
Group=lifewithlabr
WorkingDirectory=/opt/lifewithlabr/current
Environment=NODE_ENV=production
Environment=PORT=4180
Environment=CMS_DATA_DIR=/var/lib/lifewithlabr
Environment=CMS_ADMIN_ORIGIN=https://admin.lifewithlabr.ru
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/opt/lifewithlabr/runtime/bin/node cms/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lifewithlabr
MemoryMax=600M
TasksMax=64

[Install]
WantedBy=multi-user.target
